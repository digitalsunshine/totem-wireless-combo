/*
 * ZMK Keymap for Totem Split Keyboard (38 keys)
 * Customized with adjusted combo key positions & Layer 3 numpad combos.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        /* Tap Dance 0: Single Tap = Left Click, Double Tap = Middle Click */
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <170>;
            bindings = <&mkp LCLK>, <&mkp MCLK>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ================================================================== */
        /*                  BASE LAYER (LAYER 0) COMBOS                       */
        /* ================================================================== */

        combo_minus {
            timeout-ms = <50>;
            key-positions = <12 34>;
            layers = <0>;
            bindings = <&kp MINUS>;
        };

        combo_j {
            timeout-ms = <50>;
            key-positions = <3 34>;
            layers = <0>;
            bindings = <&kp J>;
        };

        combo_g {
            timeout-ms = <50>;
            key-positions = <13 34>;
            layers = <0>;
            bindings = <&kp G>;
        };

        combo_b {
            timeout-ms = <50>;
            key-positions = <16 35>;
            layers = <0>;
            bindings = <&kp B>;
        };

        combo_h {
            timeout-ms = <50>;
            key-positions = <17 35>;
            layers = <0>;
            bindings = <&kp H>;
        };

        combo_c {
            timeout-ms = <50>;
            key-positions = <6 35>;
            layers = <0>;
            bindings = <&kp C>;
        };

        combo_q {
            timeout-ms = <50>;
            key-positions = <11 34>;
            layers = <0>;
            bindings = <&kp Q>;
        };

        combo_w {
            timeout-ms = <50>;
            key-positions = <8 35>;
            layers = <0>;
            bindings = <&kp W>;
        };

        combo_v {
            timeout-ms = <50>;
            key-positions = <7 35>;
            layers = <0>;
            bindings = <&kp V>;
        };

        combo_x {
            timeout-ms = <50>;
            key-positions = <19 35>;
            layers = <0>;
            bindings = <&kp X>;
        };

        combo_z {
            timeout-ms = <50>;
            key-positions = <1 34>;
            layers = <0>;
            bindings = <&kp Z>;
        };

        combo_y {
            timeout-ms = <50>;
            key-positions = <2 34>;
            layers = <0>;
            bindings = <&kp Y>;
        };

        combo_f {
            timeout-ms = <50>;
            key-positions = <18 35>;
            layers = <0>;
            bindings = <&kp F>;
        };

        combo_excl {
            timeout-ms = <50>;
            key-positions = <3 10>;
            layers = <0>;
            bindings = <&kp EXCL>;
        };

        combo_question {
            timeout-ms = <50>;
            key-positions = <2 10>;
            layers = <0>;
            bindings = <&kp QUESTION>;
        };

        combo_slash {
            timeout-ms = <50>;
            key-positions = <1 10>;
            layers = <0>;
            bindings = <&kp SLASH>;
        };

        combo_comma {
            timeout-ms = <50>;
            key-positions = <12 10>;
            layers = <0>;
            bindings = <&kp COMMA>;
        };

        combo_dot {
            timeout-ms = <50>;
            key-positions = <13 10>;
            layers = <0>;
            bindings = <&kp DOT>;
        };

        combo_bspc {
            timeout-ms = <50>;
            key-positions = <2 11>;
            layers = <0>;
            bindings = <&kp BSPC>;
        };

        combo_del {
            timeout-ms = <50>;
            key-positions = <2 13>;
            layers = <0>;
            bindings = <&kp DEL>;
        };

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 10>;
            layers = <0>;
        };

        /* One-Shot Modifiers */

        combo_osm_shift_right {
            timeout-ms = <50>;
            key-positions = <16 17>;
            layers = <0>;
            bindings = <&sk LSHFT>;
        };

        combo_osm_alt_right {
            timeout-ms = <50>;
            key-positions = <6 7>;
            layers = <0>;
            bindings = <&sk LALT>;
        };

        combo_osm_ctrl_right {
            timeout-ms = <50>;
            key-positions = <17 18>;
            layers = <0>;
            bindings = <&sk LCTRL>;
        };

        combo_osm_gui_right {
            timeout-ms = <50>;
            key-positions = <7 8>;
            layers = <0>;
            bindings = <&sk LGUI>;
        };

        combo_osm_shft_left {
            bindings = <&sk LSHFT>;
            key-positions = <13 12>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_osm_alt_left {
            bindings = <&sk LALT>;
            key-positions = <3 2>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_osm_ctrl_left {
            bindings = <&sk LCTRL>;
            key-positions = <12 11>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_osm_gui_left {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <0>;
            bindings = <&sk LGUI>;
        };

        /* ================================================================== */
        /*                 LAYER 3 (NUMPAD) COMBOS - LEFT HAND                */
        /* ================================================================== */

        combo_l2_n7_lh {
            timeout-ms = <50>;
            key-positions = <11 12>;
            layers = <3>;
            bindings = <&kp N7>;
        };

        combo_l2_n8_lh {
            timeout-ms = <50>;
            key-positions = <12 13>;
            layers = <3>;
            bindings = <&kp N8>;
        };

        combo_l2_n9_lh {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <3>;
            bindings = <&kp N9>;
        };

        combo_l2_n0_lh {
            timeout-ms = <50>;
            key-positions = <2 3>;
            layers = <3>;
            bindings = <&kp N0>;
        };

        combo_l2_minus_lh {
            timeout-ms = <50>;
            key-positions = <10 13>;
            layers = <3>;
            bindings = <&kp MINUS>;
        };

        combo_l2_plus_lh {
            timeout-ms = <50>;
            key-positions = <10 12>;
            layers = <3>;
            bindings = <&kp PLUS>;
        };

        combo_l2_equal_lh {
            timeout-ms = <50>;
            key-positions = <10 11>;
            layers = <3>;
            bindings = <&kp EQUAL>;
        };

        combo_l2_slash_lh {
            timeout-ms = <50>;
            key-positions = <10 3>;
            layers = <3>;
            bindings = <&kp SLASH>;
        };

        combo_l2_astrk_lh {
            timeout-ms = <50>;
            key-positions = <10 2>;
            layers = <3>;
            bindings = <&kp ASTRK>;
        };

        combo_l2_bspc_lh {
            timeout-ms = <50>;
            key-positions = <10 1>;
            layers = <3>;
            bindings = <&kp BSPC>;
        };

        /* ================================================================== */
        /*                 LAYER 3 (NUMPAD) COMBOS - RIGHT HAND               */
        /* ================================================================== */

        combo_l2_n7_rh {
            timeout-ms = <50>;
            key-positions = <16 17>;
            layers = <3>;
            bindings = <&kp N7>;
        };

        combo_l2_n8_rh {
            timeout-ms = <50>;
            key-positions = <17 18>;
            layers = <3>;
            bindings = <&kp N8>;
        };

        combo_l2_n9_rh {
            timeout-ms = <50>;
            key-positions = <6 7>;
            layers = <3>;
            bindings = <&kp N9>;
        };

        combo_l2_n0_rh {
            timeout-ms = <50>;
            key-positions = <7 8>;
            layers = <3>;
            bindings = <&kp N0>;
        };

        combo_l2_minus_rh {
            timeout-ms = <50>;
            key-positions = <16 19>;
            layers = <3>;
            bindings = <&kp MINUS>;
        };

        combo_l2_plus_rh {
            timeout-ms = <50>;
            key-positions = <17 19>;
            layers = <3>;
            bindings = <&kp PLUS>;
        };

        combo_l2_equal_rh {
            timeout-ms = <50>;
            key-positions = <18 19>;
            layers = <3>;
            bindings = <&kp EQUAL>;
        };

        combo_l2_slash_rh {
