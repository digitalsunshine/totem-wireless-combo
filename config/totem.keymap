/*
 * ZMK Keymap for Totem Split Keyboard (38 keys)
 * Customized with adjusted combo key positions & Layer 3 numpad combos.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        /* Tap Dance 0: Single Tap = Right Click, Double Tap = Middle Click */

        td0: mouse_tap {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <170>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;

            label = "mouse_tap";
        };

        td1: neverclick {
            compatible = "zmk,behavior-tap-dance";
            label = "neverclick";
            #binding-cells = <0>;
            bindings = <&lt 4 LA(K)>, <&kp LA(LS(K))>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ================================================================== */
        /*                  BASE LAYER (LAYER 0) COMBOS                       */
        /* ================================================================== */

        combo_minus {
            timeout-ms = <50>;
            key-positions = <12 34>;
            layers = <0>;
            bindings = <&kp MINUS>;
        };

        combo_j {
            timeout-ms = <50>;
            key-positions = <3 34>;
            layers = <0>;
            bindings = <&kp J>;
        };

        combo_g {
            timeout-ms = <50>;
            key-positions = <13 34>;
            layers = <0>;
            bindings = <&kp G>;
        };

        combo_b {
            timeout-ms = <50>;
            key-positions = <16 35>;
            layers = <0>;
            bindings = <&kp B>;
        };

        combo_h {
            timeout-ms = <50>;
            key-positions = <17 35>;
            layers = <0>;
            bindings = <&kp H>;
        };

        combo_c {
            timeout-ms = <50>;
            key-positions = <6 35>;
            layers = <0>;
            bindings = <&kp C>;
        };

        combo_q {
            timeout-ms = <50>;
            key-positions = <11 34>;
            layers = <0>;
            bindings = <&kp Q>;
        };

        combo_w {
            timeout-ms = <50>;
            key-positions = <8 35>;
            layers = <0>;
            bindings = <&kp W>;
        };

        combo_v {
            timeout-ms = <50>;
            key-positions = <7 35>;
            layers = <0>;
            bindings = <&kp V>;
        };

        combo_x {
            timeout-ms = <50>;
            key-positions = <19 35>;
            layers = <0>;
            bindings = <&kp X>;
        };

        combo_z {
            timeout-ms = <50>;
            key-positions = <1 34>;
            layers = <0>;
            bindings = <&kp Z>;
        };

        combo_y {
            timeout-ms = <50>;
            key-positions = <2 34>;
            layers = <0>;
            bindings = <&kp Y>;
        };

        combo_f {
            timeout-ms = <50>;
            key-positions = <18 35>;
            layers = <0>;
            bindings = <&kp F>;
        };

        combo_excl {
            timeout-ms = <50>;
            key-positions = <6 19>;
            layers = <0>;
            bindings = <&kp EXCL>;
        };

        combo_question {
            timeout-ms = <50>;
            key-positions = <7 19>;
            layers = <0>;
            bindings = <&kp QUESTION>;
        };

        combo_slash {
            timeout-ms = <50>;
            key-positions = <8 19>;
            layers = <0>;
            bindings = <&kp SLASH>;
        };

        combo_comma {
            timeout-ms = <50>;
            key-positions = <12 10>;
            layers = <0>;
            bindings = <&kp COMMA>;
        };

        combo_dot {
            timeout-ms = <50>;
            key-positions = <13 10>;
            layers = <0>;
            bindings = <&kp DOT>;
        };

        combo_bspc {
            timeout-ms = <50>;
            key-positions = <2 11>;
            layers = <0>;
            bindings = <&kp BSPC>;
        };

        combo_del {
            timeout-ms = <50>;
            key-positions = <2 13>;
            layers = <0>;
            bindings = <&kp DEL>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <1 10>;
            layers = <0>;
        };

        combo-tab {
            bindings = <&kp TAB>;
            key-positions = <3 13>;
            layers = <0>;
        };

        combo-leftbracket {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 12>;
            layers = <0>;
        };

        combo-rightbracket {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 17>;
            layers = <0>;
        };

        /* One-Shot Modifiers */

        combo_osm_shift_right {
            timeout-ms = <50>;
            key-positions = <16 17>;
            layers = <0>;
            bindings = <&sk LSHFT>;
        };

        combo_osm_alt_right {
            timeout-ms = <50>;
            key-positions = <6 7>;
            layers = <0>;
            bindings = <&sk LALT>;
        };

        combo_osm_ctrl_right {
            timeout-ms = <50>;
            key-positions = <17 18>;
            layers = <0>;
            bindings = <&sk LCTRL>;
        };

        combo_osm_gui_right {
            timeout-ms = <50>;
            key-positions = <7 8>;
            layers = <0>;
            bindings = <&sk LGUI>;
        };

        combo_osm_shft_left {
            bindings = <&sk LSHFT>;
            key-positions = <13 12>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_osm_alt_left {
            bindings = <&sk LALT>;
            key-positions = <3 2>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_osm_ctrl_left {
            bindings = <&sk LCTRL>;
            key-positions = <12 11>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_osm_gui_left {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <0>;
            bindings = <&sk LGUI>;
        };

        /* ================================================================== */
        /*                 LAYER 3 (NUMPAD) COMBOS - RIGHT HAND               */
        /* ================================================================== */

        combo_l2_n7_rh {
            timeout-ms = <50>;
            key-positions = <16 17>;
            layers = <3>;
            bindings = <&kp N7>;
        };

        combo_l2_n8_rh {
            timeout-ms = <50>;
            key-positions = <17 18>;
            layers = <3>;
            bindings = <&kp N8>;
        };

        combo_l2_n9_rh {
            timeout-ms = <50>;
            key-positions = <6 7>;
            layers = <3>;
            bindings = <&kp N9>;
        };

        combo_l2_n0_rh {
            timeout-ms = <50>;
            key-positions = <7 8>;
            layers = <3>;
            bindings = <&kp N0>;
        };

        combo_l2_minus_rh {
            timeout-ms = <50>;
            key-positions = <16 19>;
            layers = <3>;
            bindings = <&kp MINUS>;
        };

        combo_l2_plus_rh {
            timeout-ms = <50>;
            key-positions = <17 19>;
            layers = <3>;
            bindings = <&kp PLUS>;
        };

        combo_l2_equal_rh {
            timeout-ms = <50>;
            key-positions = <18 19>;
            layers = <3>;
            bindings = <&kp EQUAL>;
        };

        combo_l2_slash_rh {
            timeout-ms = <50>;
            key-positions = <6 19>;
            layers = <3>;
            bindings = <&kp SLASH>;
        };

        combo_l2_astrk_rh {
            timeout-ms = <50>;
            key-positions = <7 19>;
            layers = <3>;
            bindings = <&kp ASTRK>;
        };

        /* ================================================================== */
        /*                             MISC COMBOS                            */
        /* ================================================================== */

        combo_output_usb {
            bindings = <&out OUT_USB>;
            key-positions = <6 7>;
            layers = <2>;
        };

        combo_output_ble {
            bindings = <&out OUT_BLE>;
            key-positions = <7 8>;
            layers = <2>;
        };

        combo_mouse-toggle {
            bindings = <&to 1>;
            key-positions = <16 7 18>;
            layers = <0>;
        };

        combo_nav-toggle {
            bindings = <&to 2>;
            key-positions = <2 11 13>;
            layers = <0>;
        };

        combo_bspc-nav {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 16>;
            layers = <2>;
        };

        combo_del-nav {
            bindings = <&kp DEL>;
            key-positions = <7 18>;
            layers = <2>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <6 16>;
            layers = <0>;
        };
    };

    /* ================================================================== */
    /*                               KEYMAP                               */
    /* ================================================================== */

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
       &none           &kp P     &kp O          &kp U            &none        &none     &kp K           &kp L         &kp D            &none
       &lt 1 I         &kp N     &kp E          &kp A            &none        &none     &kp M           &kp T         &kp S            &lt 2 R
&none  &kp DOWN_ARROW  &kp LEFT  &kp UP         &kp RIGHT        &none        &none     &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mmv MOVE_DOWN  &td0
                                 &lt 3 PAGE_UP  &lt 2 PAGE_DOWN  &kp SPACE    &kp BSPC  &lt 3 DEL       &td1
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
       &none  &mt LEFT_CONTROL LC(Z)  &msc SCRL_UP          &mt LEFT_SHIFT LC(Y)   &none          &none      &mt LC(X) LC(C)  &mt LS(LC(V)) LC(V)  &mt LC(A) LC(D)  &none
       &to 0  &msc SCRL_LEFT          &msc SCRL_DOWN        &msc SCRL_RIGHT        &none          &none      &mmv MOVE_LEFT   &mmv MOVE_UP         &mmv MOVE_RIGHT  &mmv MOVE_DOWN
&none  &none  &none                   &none                 &none                  &none          &none      &none            &none                &none            &none           &none
                                      &lt 3 LA(LEFT_ARROW)  &lt 2 LA(RIGHT_ARROW)  &kp LA(TAB)    &mkp LCLK  &td0             &lt 5 DELETE
            >;
        };

        nav_media_layer {
            label = "NAV";
            bindings = <
       &none           &mt LC(LS(PAGE_UP)) RC(PAGE_UP)  &mt HOME END     &mt LC(LS(PAGE_DOWN)) LC(PAGE_DOWN)  &none    &none                     &bt BT_SEL 0              &bt BT_SEL 1              &bt BT_SEL 2        &none
       &kp DOWN_ARROW  &kp LEFT_ARROW                   &kp UP_ARROW     &kp RIGHT_ARROW                      &none    &none                     &mt LEFT_SHIFT LS(LA(K))  &mt LCTRL LA(M)           &mt LEFT_ALT LA(R)  &to 0
&none  &none           &none                            &none            &none                                &none    &none                     &none                     &none                     &none               &none  &none
                                                        &lt 3 BACKSPACE  &none                                &none    &mt LEFT_SHIFT BACKSPACE  &mt LEFT_CONTROL DELETE   &mt LEFT_ALT PRINTSCREEN
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
       &none           &kp LA(R)        &mt LA(BACKSPACE) LA(M)  &mt LA(LS(K)) LA(K)    &none                      &none          &kp N4  &kp N5         &kp N6  &none
       &mt CAPS ENTER  &mt LC(A) LC(D)  &mt LC(X) LC(C)          &mt LC(LS(V)) LC(V)    &none                      &none          &kp N1  &kp N2         &kp N3  &kp DOT
&none  &none           &none            &none                    &none                  &none                      &none          &none   &none          &none   &none    &none
                                        &kp BACKSPACE            &mt C_PREVIOUS C_NEXT  &mt C_MUTE C_PLAY_PAUSE    &kp C_AL_CALC  &none   &kp BACKSPACE
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
       &none      &kp CARET  &kp PRCNT            &kp AMPS             &none                      &none  &kp DQT   &kp AT     &kp HASH  &none
       &kp TILDE  &kp BSLH   &kp LBKT             &kp RIGHT_BRACKET    &none                      &none  &kp APOS  &kp COLON  &kp SEMI  &kp DOLLAR
&none  &none      &none      &none                &none                &none                      &none  &none     &none      &none     &none       &none
                             &mt C_PREV C_VOL_DN  &mt C_NEXT C_VOL_UP  &mt C_MUTE C_PLAY_PAUSE    &none  &none     &none
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
       &none  &kp F4  &kp F5  &kp F6  &none    &none           &kp F10           &kp F11       &kp F12  &none
       &none  &kp F1  &kp F2  &kp F3  &none    &none           &kp F7            &kp F8        &kp F9   &lt 10 ENTER
&none  &none  &none   &none   &none   &none    &none           &none             &none         &none    &none         &none
                      &none   &none   &none    &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT
            >;
        };

        misc1_layer {
            label = "MISC1";
            bindings = <
       &none  &none  &none   &none   &none     &none  &none  &none  &none  &none
       &none  &none  &none   &none   &none     &none  &none  &none  &none  &none
&none  &none  &none  &none   &none   &none     &none  &none  &none  &none  &none  &none
                     &trans  &trans  &trans    &none  &none  &none
            >;
        };

        misc2_layer {
            label = "MISC2";
            bindings = <
       &none  &none  &none   &none   &none     &none  &none  &none  &none  &none
       &none  &none  &none   &none   &none     &none  &none  &none  &none  &none
&none  &none  &none  &none   &none   &none     &none  &none  &none  &none  &none  &none
                     &trans  &trans  &trans    &none  &none  &none
            >;
        };

        misc3_layer {
            label = "MISC3";
            bindings = <
       &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
       &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;
        };

        misc4_layer {
            label = "MISC4";
            bindings = <
       &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
       &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;
        };

        boot_layer {
            label = "boot";
            bindings = <
       &none  &none  &none  &none  &none    &none  &bt BT_CLR      &bt BT_CLR  &bt BT_CLR  &none
       &none  &none  &none  &none  &none    &none  &studio_unlock  &none       &none       &none
&none  &none  &none  &none  &none  &none    &none  &none           &none       &none       &none  &none
                     &none  &none  &none    &none  &none           &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        function-layer {
            if-layers = <1 2>;
            then-layer = <5>;
        };

        misc2_layer {
            if-layers = <2 3>;
            then-layer = <7>;
        };

        misc1_layer {
            if-layers = <1 3>;
            then-layer = <6>;
        };
    };
};
